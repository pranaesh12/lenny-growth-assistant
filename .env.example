# ==========================================================
# Lenny Growth Assistant
# Environment Configuration
# Copy this file to .env and update the values.
# ==========================================================

APP_NAME="Lenny Growth Assistant"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

# ==========================================================
# Database
# ==========================================================

DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>

# ==========================================================
# ChromaDB
# ==========================================================

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=lenny_growth_knowledge

# ==========================================================
# LLM Provider
# Supported:
#   ollama
#   openai
# ==========================================================

DEFAULT_PROVIDER=ollama

# ---------- OpenAI ----------

OPENAI_API_KEY=your_openai_api_key

# ---------- Ollama ----------

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

LLM_TIMEOUT=300
LLM_MAX_RETRIES=1
DEFAULT_MAX_TOKENS=512

# ==========================================================
# Embeddings
# ==========================================================

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ==========================================================
# Logging
# ==========================================================

LOG_LEVEL=INFO
LOG_DIRECTORY=./logs

# ==========================================================
# Security
# ==========================================================

SECRET_KEY=replace_with_a_random_64_character_secret

ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================================
# CORS
# ==========================================================

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]